{
  "manifest_version": 3,
  "name": "OptiPass",
  "version": "2.0.0",
  "description": "Optinet Solutions team password manager - end-to-end encrypted vaults synced via Supabase.",
  "permissions": ["storage", "alarms", "activeTab", "scripting", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OptiPass"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
