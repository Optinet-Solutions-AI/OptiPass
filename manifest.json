{
  "manifest_version": 3,
  "name": "OptiPass",
  "version": "2.7.0",
  "description": "Optinet Solutions team password manager - end-to-end encrypted vaults, autofill, and 2FA codes.",
  "permissions": ["storage", "alarms", "activeTab", "scripting", "clipboardWrite", "contextMenus"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OptiPass"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
